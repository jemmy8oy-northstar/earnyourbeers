  "components": {
    "schemas": {
      "ActivityRequest": {
        "required": [
          "type",
          "amount"
        ],
        "type": "object",
        "properties": {
          "type": {
            "$ref": "#/components/schemas/ActivityType"
          },
          "amount": {
            "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?(?:[eE][+-]?\\d+)?$",
            "type": [
              "number",
              "string"
            ],
            "format": "double"
          }
        }
      },
      "ActivityType": {
        "enum": [
          "Run",
          "Cycle",
          "Swim"
        ]
      },
      "AmountRequest": {
        "required": [
          "amount"
        ],
        "type": "object",
        "properties": {
          "amount": {
            "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?(?:[eE][+-]?\\d+)?$",
            "type": [
              "number",
              "string"
            ],
            "format": "double"
          }
        }
      },
      "Credentials": {
        "required": [
          "username",
          "password"
        ],
        "type": "object",
        "properties": {
          "username": {
            "type": "string"
          },
          "password": {
            "type": "string"
          }
        }
      },
      "OnboardRequest": {
        "required": [
          "sport",
          "weeklyVolume",
          "viceEmoji",
          "weeklyViceCount"
        ],
        "type": "object",
        "properties": {
          "sport": {
            "$ref": "#/components/schemas/ActivityType"
          },
          "weeklyVolume": {
            "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?(?:[eE][+-]?\\d+)?$",
            "type": [
              "number",
              "string"
            ],
            "format": "double"
          },
          "viceEmoji": {
            "type": [
              "null",
              "string"
            ]
          },
          "weeklyViceCount": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          }
        }
      },
      "ResetRequest": {
        "required": [
          "confirm"
        ],
        "type": "object",
        "properties": {
          "confirm": {
            "type": "boolean"
          }
        }
      },
      "ViceRequest": {
        "required": [
          "viceEmoji"
        ],
        "type": "object",
        "properties": {
          "viceEmoji": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      }
    }
  },
  "tags": [
    {
      "name": "Balenthiran.EarnYourBeers.WebApi"
    }
  ]
